
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6fb;
    color: #1e293b;
    line-height: 1.6;
}

/* Header */
header {
    background: linear-gradient(135deg, #172554, #1e40af);
    color: white;
    text-align: center;
    padding: 85px 20px;
}

header h1 {
    font-size: 46px;
    margin-bottom: 12px;
    letter-spacing: 1px;
}

header p {
    color: #dbeafe;
    font-size: 18px;
}

/* Main section */
main {
    max-width: 1100px;
    margin: 65px auto;
    padding: 0 25px;
    text-align: center;
}

main h2 {
    font-size: 30px;
    margin-bottom: 35px;
    color: #172554;
}

/* Project layout */
.projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

/* Individual project cards */
.project-card {
    background: white;
    padding: 35px 25px;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    text-align: center;
    transition: transform 0.25s, box-shadow 0.25s;
}

.project-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
}

.project-card h3 {
    font-size: 22px;
    margin-bottom: 15px;
    color: #172554;
}

.project-card p {
    color: #64748b;
    font-size: 15px;
    margin-bottom: 25px;
}

/* Project links */
.project-card a {
    display: inline-block;
    text-decoration: none;
    background: #1e40af;
    color: white;
    padding: 9px 15px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: bold;
    margin: 4px;
    transition: background 0.2s;
}

.project-card a:hover {
    background: #172554;
}

/* Footer */
footer {
    text-align: center;
    padding: 35px 20px;
    background: #e2e8f0;
    color: #64748b;
    margin-top: 80px;
}

footer a {
    color: #1e40af;
    text-decoration: none;
    font-weight: bold;
}

footer a:hover {
    text-decoration: underline;
}

/* Responsive layout */
@media (max-width: 850px) {
    .projects {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    header {
        padding: 65px 20px;
    }

    header h1 {
        font-size: 34px;
    }

    main {
        margin: 40px auto;
    }

    .projects {
        grid-template-columns: 1fr;
    }
}
